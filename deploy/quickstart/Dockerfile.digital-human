# 多阶段构建：编译阶段用 maven 镜像从源码打包，运行阶段只留 JRE。
#
# 与 digital-human/Dockerfile 的分工：
#   - digital-human/Dockerfile        生产/CI 用：宿主机已 package 出 jar，镜像只负责运行；
#   - 本文件（quickstart）            本机一键启动用：你不需要装 JDK 与 Maven，镜像自己编译。
#
# 参数与 digital-human/Dockerfile 保持一致：JDK 21（enforcer 要求 [21,22)），
# 非 root 运行，时区与字符集跟业务一致。
#
# 两个 FROM 各用一个 ARG，且**都声明在第一个 FROM 之前**：
# 只有第一个 FROM 之前的 ARG 才是全局构建参数，第一个 FROM 之后声明的同名 ARG
# 只属于它所在的那一段，第二个 FROM 用不到（实测报错：base name (${RUNTIME_IMAGE}) should not be blank）。
ARG BUILD_IMAGE=maven:3.9-eclipse-temurin-21
ARG RUNTIME_IMAGE=eclipse-temurin:21-jre-alpine

FROM ${BUILD_IMAGE} AS build

WORKDIR /src

# 只先复制 POM，把依赖下载单独缓存成一层：
# 之后改 Java 代码不会重新下载整个依赖树。
COPY pom.xml ./
COPY digital-human/pom.xml digital-human/
COPY digital-human-mcp/pom.xml digital-human-mcp/
RUN mvn -B -ntp -pl digital-human -am dependency:go-offline

# 再复制源码并打包（跳过测试：一键启动要快，跑测试请用 ./mvnw test）
COPY digital-human/src digital-human/src
RUN mvn -B -ntp -pl digital-human -am -DskipTests package

# ---------------- 运行阶段 ----------------
FROM ${RUNTIME_IMAGE}

ENV TZ=Asia/Shanghai \
    LANG=C.UTF-8 \
    JAVA_OPTS="-XX:MaxRAMPercentage=75 -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai"

WORKDIR /app

RUN addgroup -S app 2>/dev/null || true \
 && adduser -S app -G app 2>/dev/null || true

COPY --from=build /src/digital-human/target/*.jar /app/app.jar
RUN chown -R app:app /app
USER app

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
