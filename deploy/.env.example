# .env 模板：CI 会自动生成同名文件并传到服务器（deploy/deploy-remote.sh）。
# 手工部署时才需要复制成 .env 并填值；该文件已被 .gitignore 忽略，禁止提交。
#
# 变量与 docs/CI-CD配置清单.md 一一对应。

# 镜像与版本（由 CI 写入；VERSION 用带 sha 的唯一标签，不要用 saa-日期 这种会移动的标签回滚）
VERSION=saa-20260928-abc1234
DOCKER_REGISTRY=registry.us-west-1.aliyuncs.com
DOCKER_NAMESPACE=platweb
APP_DIGITAL_HUMAN_IMAGE=registry.us-west-1.aliyuncs.com/platweb/public
APP_MCP_IMAGE=registry.us-west-1.aliyuncs.com/platweb/public-mcp

# 对外端口
APP_PORT=8080
MCP_PORT=8081

# 模型密钥（只从环境变量注入，不进镜像、不进仓库）
APP_DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 数字人应用的数据源
APP_DB_URL=jdbc:mysql://host.docker.internal:3306/digital_human?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
APP_DB_USER=root
APP_DB_PASSWORD=change-me

# MCP Server 自己的数据源（独立库，存放展厅预约）
APP_MCP_DB_URL=jdbc:mysql://host.docker.internal:3306/digital_human_ext?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
APP_MCP_DB_USER=root
APP_MCP_DB_PASSWORD=change-me
