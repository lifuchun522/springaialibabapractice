<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.digitalhuman</groupId>
        <artifactId>spring-ai-alibaba-practice</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>digital-human</artifactId>
    <name>digital-human</name>
    <description>数字人项目最小骨架：以 ChatClient 为唯一模型调用出口</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 第 3 掌：数字人底座要落三张表，表结构由 Flyway 建，Hibernate 只做 validate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 只要 BCrypt，不引入整套 Spring Security（Demo 的令牌方案是自管的） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!--
          模型通道：DeepSeek 走 OpenAI 兼容协议。
          版本由父 pom 的 spring-ai-bom 管理，此处不写版本号。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!--
          第 7 掌：MCP Client。
          展厅预约这份能力已拆成独立 MCP Server（digital-human-mcp 模块），
          这里只做调用方：用 streamable-http 传输远程消费它的工具。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client-webflux</artifactId>
        </dependency>

        <!--
          第 8 掌：RAG。
          只引入 VectorStore 抽象与内存实现（SimpleVectorStore）——真源在 knowledge_document 表，
          向量库只是可重建的投影；生产要换持久化向量库（按文章要求逐库核验过滤语义）。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store</artifactId>
        </dependency>

        <!--
          第 9 掌：Agent Framework。
          这是本仓库第一次真正用到 Spring AI Alibaba 自己的模块（前八掌只用 Spring AI 抽象 + 自写适配）：
          ReactAgent 把「模型 ↔ 工具」的多步循环交给框架，业务侧只提供 instruction 与工具，并挂运行时边界。
        -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-agent-framework</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 测试用内存库：单测要能离线、确定性跑通，不依赖本机 MySQL -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          第 15 掌：L2 组件层把 mock 边界从 ChatModel 撤到 HTTP 层。
          MockWebServer 是「可观测的替身」——它让我们看到**我们发出去的请求**长什么样
          （工具定义在不在、System Prompt 有没有带、历史有没有回灌），
          而不是假设「对方会回什么」。版本由 spring-boot-dependencies 管。
        -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          第 15 掌：L3 集成层用 Testcontainers 起真实依赖。
          本仓库的真源是 MySQL + Flyway（不是 pgvector），所以容器也换 MySQL：
          这一层只验证「配置与连接真的能起来」，不验证回答质量。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          第 16 掌：分层的第一价值是**变更隔离**，而隔离的判据是依赖方向，不是目录结构。
          光把文件挪进不同的包，`web` 里照样能 import ChatClient，得到的只会是一个更精致的 Demo——
          所以这一掌把依赖方向写成**可执行的规则**（ArchUnit），并放进 CI 阻断路径：
          违反一次就红一次，而不是等 review 时靠人眼发现。
          版本显式钉住：archunit-junit5 不在 Spring Boot 的依赖管理里。
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.0</version>
            <scope>test</scope>
        </dependency>

        <!--
          第 16 掌：SSE 是流式契约，而流式最容易出的不是「内容错了」，是「流不结束」——
          数据早答完了、连接还开着，客户端只能等超时。这类断言用 StepVerifier 写才看得清
          （完成信号、取消信号、时间轴都由它显式表达）。版本由 spring-boot-dependencies 管。
        -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          第 17 掌：可观测。
          三条通道各司其职，缺一条就会出现「看得见指标但追不到链路」或「有 span 但没有可聚合的数」：
          - micrometer-tracing-bridge-otel：把 Observation 接到 OpenTelemetry 的 trace 体系；
          - opentelemetry-exporter-otlp：把 span 送出去（本环境没有采集后端，见 ch17 验收记录的说明）；
          - micrometer-registry-prometheus：把指标暴露成 /actuator/prometheus，供看板与告警抓取。
          版本一律由 spring-boot-dependencies 管。
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!--
          第 13 掌：服务发现。注册中心是**可选中间层**——
          本地单实例开发用配置里的静态实例表，多实例/扩缩容时才需要 Nacos；
          Nacos 不可用时明确告警并退回静态表，主服务不会因为注册中心挂掉而不可用。
        -->
        <dependency>
            <groupId>com.alibaba.nacos</groupId>
            <artifactId>nacos-client</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
