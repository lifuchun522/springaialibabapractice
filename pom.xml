<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.10</version>
        <relativePath/>
    </parent>

    <groupId>com.example.digitalhuman</groupId>
    <artifactId>spring-ai-alibaba-practice</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>spring-ai-alibaba-practice</name>
    <description>降 SpringAI 阿里十八掌练习仓库：从最小骨架到数字人 Agent 平台</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 生产基线：Spring AI Alibaba v1.1.2.2（Latest），配套 Spring AI 1.1.2 / Spring Boot 3.5.10
             v2.0.0-M1.1 属 Pre-release，只作观察线，不进生产 -->
        <spring-ai.version>1.1.2</spring-ai.version>
        <spring-ai-alibaba.version>1.1.2.2</spring-ai-alibaba.version>

        <!--
          第 15 掌：五层测试的 tag 隔离。
          默认只跑离线层（L1 单元 + L2 组件）——它必须离线、可重复、失败即可信：

              ./mvnw -B -ntp clean verify                       # CI：L1 + L2，阻断合并
              ./mvnw -B -ntp verify -Dsurefire.groups=integration -Dsurefire.excludedGroups=   # L3 真实依赖
              ./mvnw -B -ntp verify -Dsurefire.groups=eval -Dsurefire.excludedGroups=          # L4 离线回归评测
              ./mvnw -B -ntp verify -Dsurefire.groups=eval-live -Dsurefire.excludedGroups=     # L5 在线评测

          为什么用属性而不是写死在插件里：写死之后「跑一次集成测试」就得改 pom 再改回来，
          而这类改动迟早会被顺手提交。评测层单独跑，不是因为它慢，而是因为它的失败原因
          可能是环境或模型——混进 CI 只会让 CI 的红绿失去意义。
        -->
        <surefire.groups></surefire.groups>
        <surefire.excludedGroups>integration,eval,eval-live</surefire.excludedGroups>
    </properties>

    <modules>
        <module>digital-human</module>
        <module>digital-human-mcp</module>
        <module>knowledge-agent</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- 框架版本一律交给 BOM，子模块禁止手写框架版本号 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 1.1.2.2 把坐标拆成两个 BOM：agent/graph/studio 与 extensions 各管一段，
                 两个都必须引入，否则 dashscope starter 会报 version is missing -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-extensions-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
              第 3 掌引入 JPA 后，dependencyConvergence 门禁第一次真的拦住了东西：
                Hibernate(经 spring-data-jpa) → antlr4-runtime 4.13.0
                Spring AI 的 ST 模板         → antlr4-runtime 4.13.1
              处置方式是统一到较高的补丁版本，而不是把门禁关掉或 exclude 掉其中一个。
            -->
            <dependency>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-runtime</artifactId>
                <version>4.13.1</version>
            </dependency>

            <!--
              第 7 掌引入 MCP Client 后，同一把门禁第二次拦住东西：
                spring-ai-model  → swagger-annotations-jakarta 2.2.38
                mcp-annotations  → swagger-annotations-jakarta 2.2.36
              同样统一到较高版本。两次都是「门禁先报，再去查是谁带进来的」，
              而不是等到运行期出现 NoSuchMethodError 才回头找。
            -->
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>2.2.55</version>
            </dependency>

            <!--
              第 13 掌引入 Nacos 客户端做服务发现。这里显式钉版本：
              生态里 nacos-client 有 2.x 与 3.x 两条线，不钉住就会出现「同一个注册中心两套客户端」，
              而这类问题在本地单实例时看不出来，只在多实例注册/订阅时暴露。
            -->
            <dependency>
                <groupId>com.alibaba.nacos</groupId>
                <artifactId>nacos-client</artifactId>
                <version>2.4.3</version>
            </dependency>

            <!--
              第 13 掌引入 nacos-client 后，同一把门禁第四次拦住东西：
                spring-ai-alibaba-agent-framework → httpclient 4.5.14
                nacos-client → httpasyncclient            → httpclient 4.5.13
              处置照旧：统一到较高补丁版本。顺带说明一句——
              「引入一个注册中心客户端」从来不是「加一个 jar」，它带进来的传递依赖同样要过门禁。
            -->
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient</artifactId>
                <version>4.5.14</version>
            </dependency>

            <!--
              第 9 掌引入 Agent Framework 后，同一把门禁第三次拦住东西，而且一次拦两个：
                spring-ai-alibaba-graph-core → io.modelcontextprotocol.sdk:mcp 0.14.0
                Spring AI 1.1.2 的 mcp-client     → io.modelcontextprotocol.sdk:mcp 0.17.0
                spring-ai-alibaba-graph-core → org.jetbrains:annotations 13.0
                flexmark（经 agent-framework）  → org.jetbrains:annotations 24.0.1

              第一条值得单独记一笔：**Sprig AI 与 Spring AI Alibaba 的 MCP SDK 版本本来就不同步**
              （0.17.0 vs 0.14.0）。第 7 掌那次「文章说工具会静默为空、我们实测直接抛
              McpTransportException」的协议差异，根因就在这类版本错位上。

              处置仍是统一到与 Spring AI 对齐的 0.17.0（不是 exclude，也不是关掉门禁）：
              MCP 客户端是 Spring AI 的那一套，跑的是 0.17.0；把 graph-core 也拉到同一版本，
              避免同一个 SDK 在进程里出现两份。**代价必须用真实调用验证**——
              graph-core 是按 0.14.0 编译的，所以第 9 掌的验收里保留了「Agent 真实调用远程 MCP 工具」
              这一条（见 docs/ch09-验收记录.md），就是为了证明这个统一没有把运行时拆坏。
            -->
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp</artifactId>
                <version>0.17.0</version>
            </dependency>

            <dependency>
                <groupId>org.jetbrains</groupId>
                <artifactId>annotations</artifactId>
                <version>24.0.1</version>
            </dependency>

            <!--
              第 15 掌引入 L2 组件层的桩服务器。这一条不是「门禁拦住的东西」，而是**门禁没管的东西**：
              spring-boot-dependencies 管 okhttp 本体，却不管 mockwebserver，所以子模块里
              不写版本号会直接构建失败（'dependencies.dependency.version' is missing）。
              处置是显式钉到与依赖树里 okhttp 相同的 4.12.0——版本对齐这件事，
              门禁只会提醒你「已经不一致了」，不会替你选一个版本。
            -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>mockwebserver</artifactId>
                <version>4.12.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
              第 15 掌：tag 隔离落在 Surefire 上。
              排除表来自上面的 ${surefire.excludedGroups}，默认值把 integration/eval/eval-live 挡在 CI 之外。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <groups>${surefire.groups}</groups>
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>

            <!-- 环境与版本对齐门禁：基线不齐，后面每一掌都在还债 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-baseline</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>本项目基线是 JDK 21 LTS；JDK 版本不一致时先切环境，不要改 pom 降级。</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                    <message>请用仓库自带的 ./mvnw（Maven 3.9+），不要用机器上随便一个 Maven。</message>
                                </requireMavenVersion>
                                <!-- 同一个构件在依赖树里出现两个版本 = 下一个 NoSuchMethodError -->
                                <dependencyConvergence/>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
